# ──────────────────────────────────────────────────────────────
# Learnova — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── 1. FRONTEND CLIENT-SAFE VARIABLES (Exposed in browser bundle) ──
# Supabase — get these from your Supabase project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# LiveKit WebRTC Signaling URL (Public URL only, no secrets!)
VITE_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
VITE_LIVE_CLASS_PROVIDER=livekit

# Optional: VAPID public key for Web Push notifications
# VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Optional: Google OAuth Client ID (Public client ID only)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── 2. SERVER-ONLY SECRETS (NEVER USE VITE_ PREFIX, NEVER COMMIT) ──
# Store these in Supabase Edge Functions Secrets or Vercel Server Environment
# GEMINI_API_KEY=AIzaSy...
# LIVEKIT_API_KEY=API...
# LIVEKIT_API_SECRET=...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# VAPID_PRIVATE_KEY=...
# JAAS_APP_ID=...
# JAAS_KID=...
# JAAS_PRIVATE_KEY=...
